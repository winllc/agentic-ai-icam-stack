# Rendered by entrypoint.sh: ${PORTAL_HOST}, ${PF_HOST}, ${PF_UPSTREAM}.
ssl_certificate     /pki/proxy/proxy-fullchain.crt;
ssl_certificate_key /pki/proxy/proxy.key;
ssl_protocols       TLSv1.2 TLSv1.3;

proxy_set_header Host              $host;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_read_timeout 240s;           # agent runs take a while

server {                           # anything else: health check only
  listen 443 ssl default_server;
  location = /healthz { return 200 "ok\n"; }
  location / { return 421; }
}

server {
  listen 443 ssl;
  server_name ${PORTAL_HOST};
  location / { proxy_pass http://agentic-ai-service:8080; }
}

server {
  listen 443 ssl;
  server_name ${PF_HOST};
  location / {
    proxy_pass ${PF_UPSTREAM};
    # Real PingFederate: verify its certificate against the enterprise root.
    proxy_ssl_server_name on;
    proxy_ssl_name pingfederate;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /pki/tls/trust-anchor.pem;
  }
}
