# Rendered by entrypoint.sh: ${PORTAL_HOST}, ${PF_HOST}, ${PF_UPSTREAM}, ${LISTEN}, ${PUBLIC_SCHEME}.
include /etc/nginx/tls.inc;            # certificate (PROXY_TLS=true) or empty

proxy_set_header Host              $host;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_read_timeout 240s;               # agent runs take a while

server {                               # anything else: health check only
  listen ${LISTEN} default_server;
  location = /healthz { return 200 "ok\n"; }
  location / { return 421; }
}

include /etc/nginx/http-redirect.inc;  # PROXY_TLS=true: port 80 redirects to HTTPS

server {
  listen ${LISTEN};
  server_name ${PORTAL_HOST};
  location / { proxy_pass http://agentic-ai-service:8080; }
}

server {
  listen ${LISTEN};
  server_name ${PF_HOST};
  location / {
    proxy_pass ${PF_UPSTREAM};
    # Real PingFederate: verify its certificate against the enterprise root.
    proxy_ssl_server_name on;
    proxy_ssl_name pingfederate;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /pki/tls/trust-anchor.pem;
  }
}
