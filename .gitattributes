# Files that run or are parsed inside Linux containers must keep LF line endings,
# even on Windows checkouts with core.autocrlf=true ("bash\r: No such file or directory").
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.html text eol=lf
*.md text eol=lf
*.lic binary
