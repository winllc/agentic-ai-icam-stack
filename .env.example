# Optional: let the agent write its assessment with Claude (otherwise rule-based).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# SPIRE image version.
SPIRE_VERSION=1.13.3

# Path to the Docker socket the SPIRE Agent's docker workload attestor reads.
# DOCKER_SOCKET=/var/run/docker.sock

# --- Only for docker-compose.pingfederate.yml (real PingFederate) ---------------
PING_IDENTITY_DEVOPS_USER=
PING_IDENTITY_DEVOPS_KEY=
PF_IMAGE_TAG=latest
PF_SERVER_PROFILE_URL=
PF_SERVER_PROFILE_PATH=
PF_ISSUER=https://localhost:9031
# PF_JWKS_URL=https://pingfederate:9031/pf/JWKS
# PF_MTLS_TOKEN_ENDPOINT=https://pingfederate:9032/as/token.oauth2
# PF_PORTAL_CLIENT_SECRET=portal-secret
# PF_REQUIRE_CNF=true
# PF_REQUIRE_ACT=true
