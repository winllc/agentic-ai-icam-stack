# Optional: let the agent write its assessment with Claude (otherwise rule-based).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Public URLs - what browsers use. Change them to run behind real DNS and/or a reverse proxy
# (deploy/reverse-proxy/). Containers keep using the internal names (pingfederate, ...).
# Defaults: http://localhost:8080 and http://localhost:9031 (simulator) / https://localhost:9031 (PingFederate).
# PORTAL_PUBLIC_URL=https://portal.example.com
# PF_PUBLIC_URL=https://sso.example.com
# Number of reverse proxies in front of the portal whose X-Forwarded-* headers are trusted (0 = none).
# TRUSTED_PROXY_HOPS=1
# Extra names on PingFederate's own TLS certificate (its PF_PUBLIC_URL host is added automatically).
# PF_TLS_EXTRA_SANS=DNS:sso-internal.example.com
# Fixed portal session key, so sign-ins survive restarts (otherwise random per start).
# PORTAL_SESSION_KEY=
# Example proxy (deploy/reverse-proxy): HTTPS upstream for real PingFederate; your proxy's CA for the test scripts.
# PF_UPSTREAM=https://pingfederate:9031
# PUBLIC_CA_BUNDLE=/path/to/ca.pem

# LDAP directory: admin (used by governance_checks.py / your ldapmodify) and service accounts.
LDAP_ADMIN_PASSWORD=admin
LDAP_SYNC_PASSWORD=sync-secret
LDAP_IDP_PASSWORD=idp-secret

# Vault: AppRole secret for SPIRE's UpstreamAuthority (demo value) and image versions.
VAULT_APPROLE_SECRET_ID=spire-approle-secret-demo
VAULT_VERSION=1.20
POSTGRES_VERSION=16-alpine
INVENTORY_DB_SUPERUSER_PASSWORD=postgres-demo

# Directory: LDAPS trust anchor when LDAP_URL is ldaps:// (e.g. pointing at RadiantLogic FID).
# LDAP_TLS_CA=/path/to/ca.pem

# SPIRE image version.
SPIRE_VERSION=1.13.3

# Path to the Docker socket the SPIRE Agent's docker workload attestor reads.
# DOCKER_SOCKET=/var/run/docker.sock

# --- Only for docker-compose.pingfederate.yml (real PingFederate) ---------------
# License file: pingfederate/license/pingfederate.lic (git-ignored, chmod 0644)
PF_IMAGE_TAG=2609-13.1.3
PF_ADMIN_USER=administrator
PF_ADMIN_PASSWORD=2FederateM0re
# Admin console URL as browsers reach it.
# PF_ADMIN_PUBLIC_URL=https://pf-admin.example.com
