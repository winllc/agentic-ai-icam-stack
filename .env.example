# Optional: let the agent write its assessment with Claude (otherwise rule-based).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# LDAP directory: admin (used by governance_checks.py / your ldapmodify) and service accounts.
LDAP_ADMIN_PASSWORD=admin
LDAP_SYNC_PASSWORD=sync-secret
LDAP_IDP_PASSWORD=idp-secret

# SPIRE image version.
SPIRE_VERSION=1.13.3

# Path to the Docker socket the SPIRE Agent's docker workload attestor reads.
# DOCKER_SOCKET=/var/run/docker.sock

# --- Only for docker-compose.pingfederate.yml (real PingFederate) ---------------
# License file: pingfederate/license/pingfederate.lic (git-ignored, chmod 0644)
PF_IMAGE_TAG=2609-13.1.3
PF_ADMIN_USER=administrator
PF_ADMIN_PASSWORD=2FederateM0re
